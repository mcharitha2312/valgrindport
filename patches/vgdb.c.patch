 #include <sys/time.h>
 #include <sys/wait.h>
 
+#if defined(VGO_openedition)
+static char *strsep(char **stringp, const char *delim)
+{
+    char *begin, *end;
+    begin = *stringp;
+    if (begin == NULL)
+        return NULL;
+    end = begin + strcspn(begin, delim);
+    if (*end) {
+        *end++ = '\0';
+        *stringp = end;
+    } else {
+        *stringp = NULL;
+    }
+    return begin;
+}
+#endif
